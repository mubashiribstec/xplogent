# ─── Xplogent environment ────────────────────────────────────────────────
# Copy this file to `.env` inside your Xplogent home folder — by default
# `~/.xplogent/.env` (or `$XPLOGENT_HOME/.env` when that variable is set) —
# and fill in what you need. A `.env` in any other folder is NOT read.
# Ollama needs nothing here.

# Active provider/model (overrides config/default.yaml). Examples:
#   ollama:llama3.1   openai:gpt-4o   anthropic:claude-sonnet-4-6   openrouter:meta-llama/llama-3.1-70b-instruct
XPLOGENT_MODEL=ollama:llama3.1

# Local Ollama (default; no key needed)
OLLAMA_HOST=http://localhost:11434

# Hosted providers (only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# API server
XPLOGENT_API_HOST=127.0.0.1
XPLOGENT_API_PORT=8765

# Data directory (memory db, skills, logs). Defaults to ~/.xplogent
# XPLOGENT_HOME=

# ─── Server deployment (Docker / systemd behind Caddy or nginx) ──────────────
# Dashboard/API access token. REQUIRED when the app is reachable from the internet;
# the deployment files set this for you. Generate:  openssl rand -hex 32
# XPLOGENT_AUTH_TOKEN=
# Set to 1 when a reverse proxy fronts the app (forces a token even on 127.0.0.1).
# XPLOGENT_BEHIND_PROXY=1
# Which proxy addresses may set X-Forwarded-* headers (default 127.0.0.1; "*" inside Docker).
# XPLOGENT_FORWARDED_ALLOW_IPS=127.0.0.1
# Folder holding a pre-built dashboard (Docker image sets this).
# XPLOGENT_WEB_DIR=
# Headless Linux: use the file-based key store instead of probing for a desktop keyring.
# PYTHON_KEYRING_BACKEND=keyring.backends.fail.Keyring
# Phone agent carrier key
# TELNYX_API_KEY=
# Browser protection: the API refuses other websites (Origin check) and, when no token is
# set, any Host that isn't this machine (anti DNS-rebinding). Add extra names/origins here:
# XPLOGENT_ALLOWED_HOSTS=mypc.local
# XPLOGENT_ALLOWED_ORIGINS=https://my-other-dashboard.example

