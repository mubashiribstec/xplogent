# Copy to .env (never commit it). Used by docker-compose.yml.

# Public hostname that points at this server (Caddy gets the HTTPS certificate for it).
DOMAIN=agent.example.com

# REQUIRED. Dashboard/API access token. Generate one:  openssl rand -hex 32
XPLOGENT_AUTH_TOKEN=

# Default model, e.g. ollama:llama3.1  openai:gpt-4o  anthropic:claude-sonnet-4-6
XPLOGENT_MODEL=openai:gpt-4o-mini
# If Ollama runs on the Docker host:  http://host.docker.internal:11434
OLLAMA_HOST=

# Provider keys (only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Phone agent
TELNYX_API_KEY=

# Optional overrides for the gpu-speech profile
# WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cuda
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest
