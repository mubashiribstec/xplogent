# Copy to .env (never commit it). docker compose reads this file automatically.
# The one-command installer (get.sh) writes it for you.

# ── Mode ────────────────────────────────────────────────────────────────────
# HTTPS with your own domain (Caddy + Let's Encrypt):
COMPOSE_FILE=docker-compose.yml:compose.https.yml
# No domain (plain HTTP on a port; see XPLOGENT_BIND below):
# COMPOSE_FILE=docker-compose.yml:compose.local.yml

# Optional extras, comma separated: ollama | ollama-gpu | speech | gpu-speech
COMPOSE_PROFILES=

# https mode: public hostname whose DNS A record points at this server.
DOMAIN=agent.example.com

# local mode: 127.0.0.1 = this machine only, 0.0.0.0 = your LAN (plain HTTP!)
XPLOGENT_BIND=127.0.0.1
XPLOGENT_PORT=8765

# ── Access ──────────────────────────────────────────────────────────────────
# REQUIRED. Dashboard/API access token. Generate one:  openssl rand -hex 32
XPLOGENT_AUTH_TOKEN=

# ── Image ───────────────────────────────────────────────────────────────────
# Prebuilt image (pin a release tag such as :v1.0.0 for production).
XPLOGENT_IMAGE=ghcr.io/mubashiribstec/xplogent:latest

# ── Models ──────────────────────────────────────────────────────────────────
# First-run default model, e.g. ollama:llama3.1  openai:gpt-4o-mini  anthropic:claude-sonnet-4-6
# (a model chosen later in the dashboard takes precedence)
XPLOGENT_MODEL=openai:gpt-4o-mini
# With the ollama / ollama-gpu profile: http://ollama:11434
# With Ollama on the Docker host:      http://host.docker.internal:11434
OLLAMA_HOST=

# Provider keys: easiest is Settings in the dashboard (stored encrypted). Uncomment only
# to set them here instead; a key set here can't be changed from the dashboard.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_API_KEY=        # bearer token for an Ollama behind an authenticating proxy
# TELNYX_API_KEY=        # phone agent (also settable in the Calls view)

# Optional image overrides
# OLLAMA_IMAGE=ollama/ollama:latest
# WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cuda
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest
# KOKORO_CPU_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest

# --- built-in SIP trunk client (set by `xplogent-docker sip on`) ---------------------
# XPLOGENT_SIP=1
# XPLOGENT_HOST_IP=192.168.1.20       # address the PBX/provider sends call audio to
# XPLOGENT_SIP_PORT=5060
# XPLOGENT_RTP_START=10000
# XPLOGENT_RTP_END=10100
# XPLOGENT_SIP_EXT_PORT=5062          # second line: PBX extension login
# XPLOGENT_RTP_EXT_START=10200
# XPLOGENT_RTP_EXT_END=10300
