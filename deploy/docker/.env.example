# Copy to .env (never commit it). docker compose reads this file automatically.
# The one-command installer (get.sh) writes it for you.

# ── Mode ────────────────────────────────────────────────────────────────────
# HTTPS with your own domain (Caddy + Let's Encrypt):
COMPOSE_FILE=docker-compose.yml:compose.https.yml
# No domain (plain HTTP on a port; see XPLOGENT_BIND below):
# COMPOSE_FILE=docker-compose.yml:compose.local.yml

# Optional extras, comma separated: speech | gpu-speech
COMPOSE_PROFILES=

# https mode: public hostname whose DNS A record points at this server.
DOMAIN=agent.example.com

# local mode: 127.0.0.1 = this machine only, 0.0.0.0 = your LAN (plain HTTP!)
XPLOGENT_BIND=127.0.0.1
XPLOGENT_PORT=8765

# ── Access ──────────────────────────────────────────────────────────────────
# REQUIRED. Dashboard/API access token. Generate one:  openssl rand -hex 32
XPLOGENT_AUTH_TOKEN=

# ── Image ───────────────────────────────────────────────────────────────────
# Prebuilt image (pin a release tag such as :v1.0.0 for production).
XPLOGENT_IMAGE=ghcr.io/mubashiribstec/xplogent:latest

# ── Models ──────────────────────────────────────────────────────────────────
# First-run default model, e.g. openai:gpt-4o-mini  anthropic:claude-sonnet-4-6
#   gemini:gemini-3.6-flash  openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# (a model chosen later in the dashboard takes precedence)
XPLOGENT_MODEL=openai:gpt-4o-mini
# Optional: your own Ollama server on another machine, e.g. https://gpu-box.example.com
# (more servers, each with its own token: Settings -> Ollama servers). No Ollama runs here.
OLLAMA_HOST=

# Provider keys: easiest is Settings in the dashboard (stored encrypted). Uncomment only
# to set them here instead; a key set here can't be changed from the dashboard.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_API_KEY=        # bearer token for an Ollama behind an authenticating proxy
# TELNYX_API_KEY=        # phone agent (also settable in the Calls view)

# Optional image overrides
# WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cuda
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest
# KOKORO_CPU_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest

# ── CRM (Xplogent ↔ Laravel CRM) ──────────────────────────────────────────────
# One shared token signs both directions: Xplogent → CRM (POST /api/xplogent/*) and
# CRM → Xplogent (POST /voip/crm/dial). It must equal XPLOGENT_API_TOKEN in the CRM's
# .env. Easiest: paste it in the dashboard (Calls → Call agent → CRM, stored encrypted).
# Uncomment only to set it here instead; a token set here can't be changed from the
# dashboard.
# XPLOGENT_CRM_API_TOKEN=
#
# The CRM address is set in the dashboard (Calls → Call agent → CRM), not here.
# Inside this container 127.0.0.1 / localhost is the container itself, never the CRM.
#
# CRM on another machine on your LAN (the usual office setup):
#   Xplogent → CRM:  http://<CRM machine's LAN IP>:8000, e.g. http://192.168.1.20:8000
#   CRM → Xplogent:  XPLOGENT_BASE_URL=http://<this server's LAN IP>:8765 in the CRM's .env.
#                    Needs the port open to the LAN: `sudo xplogent-docker local --lan`
#                    (sets XPLOGENT_BIND=0.0.0.0 above), and port 8765 allowed from the
#                    CRM machine in this server's firewall. In https mode the CRM uses
#                    https://<DOMAIN> instead.
# CRM on this same server (not in a container):
#   Xplogent → CRM:  http://host.docker.internal:8000 (mapped to this host by extra_hosts
#                    in docker-compose.yml; the CRM must listen on 0.0.0.0, not 127.0.0.1)
#   CRM → Xplogent:  XPLOGENT_BASE_URL=http://127.0.0.1:8765 (local mode) or https://<DOMAIN>
# Calls → Call agent → CRM shows the address to give the CRM, and Test connection checks
# Xplogent → CRM; `php artisan xplogent:check` on the CRM checks the other direction.

# --- built-in SIP trunk client (set by `xplogent-docker sip on`) ---------------------
# XPLOGENT_SIP=1
# XPLOGENT_HOST_IP=192.168.1.20       # address the PBX/provider sends call audio to
# XPLOGENT_SIP_PORT=5060
# XPLOGENT_RTP_START=10000
# XPLOGENT_RTP_END=10100
# XPLOGENT_SIP_EXT_PORT=5062          # second line: PBX extension login
# XPLOGENT_RTP_EXT_START=10200
# XPLOGENT_RTP_EXT_END=10300
