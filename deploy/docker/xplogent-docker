#!/usr/bin/env bash
# xplogent-docker: manage an Xplogent Docker install (made by get.sh).
#
#   xplogent-docker status              containers, health, URL
#   xplogent-docker logs [-f] [service] logs (default: xplogent)
#   xplogent-docker update              backup, refresh deploy files, pull new image, restart
#   xplogent-docker backup              consistent backup (incl. keys) into <dir>/backups
#   xplogent-docker restore FILE        restore a backup (overwrites current data)
#   xplogent-docker token [--rotate]    show (or replace) the dashboard access token
#   xplogent-docker config              edit settings (.env), then apply them
#   xplogent-docker restart | stop | start
#   xplogent-docker https DOMAIN [--force]   switch to HTTPS (Let's Encrypt; needs ports 80/443)
#   xplogent-docker local [--lan]       switch to no-domain mode (port 8765)
#   xplogent-docker ollama on [--gpu] | off
#   xplogent-docker speech on [--gpu] | off   local voices for the phone agent
#   xplogent-docker backup-model on [model] | off   local Ollama answers if the main model can't
#   xplogent-docker sip on [--ip ADDR] | off   open UDP ports for the built-in SIP trunk client
#   xplogent-docker pull-model NAME     download an Ollama model (e.g. llama3.1)
#   xplogent-docker cli ARGS...         run an xplogent command inside the container
#                                       (e.g. cli voip status · cli dial +1555… --test)
#   xplogent-docker uninstall [--purge] remove containers (--purge: also all data!)
#
# Install directory: $XPLOGENT_DOCKER_DIR, else the directory below (set by get.sh),
# else the checkout this script lives in.

set -euo pipefail

DEFAULT_DIR="/opt/xplogent-docker"
KEEP_BACKUPS=10

say()  { printf '\033[1;36m•\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -n "${XPLOGENT_DOCKER_DIR:-}" ]; then
  DIR="$XPLOGENT_DOCKER_DIR"; COMPOSE_DIR="$DIR/deploy/docker"
elif [ -f "$DEFAULT_DIR/deploy/docker/docker-compose.yml" ]; then
  DIR="$DEFAULT_DIR"; COMPOSE_DIR="$DIR/deploy/docker"
elif [ -f "$here/docker-compose.yml" ]; then
  COMPOSE_DIR="$here"; DIR="$(cd "$here/../.." && pwd)"
else
  die "no Xplogent Docker install found (looked in $DEFAULT_DIR); run get.sh first"
fi
ENV_FILE="$COMPOSE_DIR/.env"
BACKUP_DIR="$DIR/backups"
[ -f "$ENV_FILE" ] || die "$ENV_FILE is missing; run get.sh (or copy .env.example)"
cd "$COMPOSE_DIR"

set_env() {
  local file="$1" key="$2" tmp
  case "$3" in *$'\n'*) die "value for $key must be a single line" ;; esac
  tmp="$(mktemp "$file.XXXXXX")"
  XPL_V="$3" awk -v k="$key" '
    BEGIN { v = ENVIRON["XPL_V"]; done = 0 }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }' "$file" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}
get_env() { awk -v k="$1" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$ENV_FILE"; }
gen_token() {
  if command -v openssl >/dev/null 2>&1; then openssl rand -hex 32
  else head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; fi
}
dc() { docker compose "$@"; }

running() { [ -n "$(dc ps -q xplogent 2>/dev/null)" ]; }

wait_healthy() {
  for _ in $(seq 1 60); do
    if dc exec -T xplogent python -c \
        "import urllib.request as u; u.urlopen('http://127.0.0.1:8765/health', timeout=3)" >/dev/null 2>&1; then
      ok "Xplogent is healthy"; return 0
    fi
    sleep 2
  done
  die "Xplogent did not become healthy; check: xplogent-docker logs"
}

url() {
  case "$(get_env COMPOSE_FILE)" in
    *https*) echo "https://$(get_env DOMAIN)" ;;
    *)
      local host=127.0.0.1
      if [ "$(get_env XPLOGENT_BIND)" = "0.0.0.0" ]; then
        host="$(hostname -I 2>/dev/null | awk '{print $1}')"; host="${host:-<server-ip>}"
      fi
      echo "http://$host:$(get_env XPLOGENT_PORT | sed 's/^$/8765/')" ;;
  esac
}

apply() { dc up -d --remove-orphans; wait_healthy; }

# COMPOSE_FILE for a mode, keeping the SIP ports file when SIP is on.
compose_files() {
  if [ "$(get_env XPLOGENT_SIP)" = "1" ]; then echo "docker-compose.yml:$1:compose.sip.yml"
  else echo "docker-compose.yml:$1"; fi
}

add_profile() {  # add_profile NAME / remove with "-NAME"
  local cur new="" p want="$1"
  cur="$(get_env COMPOSE_PROFILES)"
  for p in ${cur//,/ }; do
    # ollama and ollama-gpu are alternatives: setting or removing one drops both.
    case "$p:${want#-}" in ollama*:ollama*) continue ;; esac
    [ "$p" = "${want#-}" ] && continue
    new="${new:+$new,}$p"
  done
  case "$want" in -*) ;; *) new="${new:+$new,}$want" ;; esac
  set_env "$ENV_FILE" COMPOSE_PROFILES "$new"
}

# ── HTTPS helpers ──────────────────────────────────────────────────────────────
public_ip() {
  local ip=""
  for u in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    ip="$(curl -4 -fsS -m 6 "$u" 2>/dev/null | tr -d ' \r\n')" || ip=""
    case "$ip" in *[!0-9.]*|"") ip="" ;; *) break ;; esac
  done
  echo "$ip"
}

domain_ips() {  # A records of $1, one per line
  { if command -v getent >/dev/null 2>&1; then getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}' | sort -u
    elif command -v dig >/dev/null 2>&1; then dig +short A "$1"
    fi; } || true
}

# Checks that catch the usual reasons Let's Encrypt can't issue a certificate.
https_precheck() {
  local domain="$1" mine ips busy
  say "Checking $domain before switching to HTTPS…"
  ips="$(domain_ips "$domain")"
  [ -n "$ips" ] || die "$domain has no A record yet. Add one at your DNS provider pointing to this \
server's public IP, wait a few minutes, then run this again (or add --force)."
  mine="$(public_ip)"
  if [ -n "$mine" ] && ! printf '%s\n' "$ips" | grep -qx "$mine"; then
    die "$domain points to $(echo $ips | tr '\n' ' ')but this server's public IP is $mine. Fix the A \
record (or add --force if a proxy/NAT in front of you makes this expected)."
  fi
  ok "DNS: $domain → ${mine:-$(echo $ips | head -1)}"
  if command -v ss >/dev/null 2>&1; then
    busy="$(ss -Hltnp '( sport = :80 or sport = :443 )' 2>/dev/null | grep -v docker-proxy || true)"
    if [ -n "$busy" ] && ! dc ps caddy 2>/dev/null | grep -q caddy; then
      die "something else on this server already listens on port 80 or 443 (e.g. Apache or nginx): \
stop it first, or put Xplogent behind it instead (see docs/deploy-linux.md)."
    fi
  fi
  say "Your router must forward TCP 80 and 443 to this server (Let's Encrypt checks port 80)."
}

set_public_url() {  # the phone agent's public address, unless one is already set to https
  dc exec -T -e XPL_URL="https://$1" xplogent python -c '
import os
from xplogent.core.config import load_config, save_user_config
cur = str((load_config().voip or {}).get("public_url") or "")
if not cur.startswith("https://"):
    save_user_config({"voip": {"public_url": os.environ["XPL_URL"]}})
' >/dev/null 2>&1 || true
}

# Follow Caddy's log until the certificate is issued or Let's Encrypt says why not.
wait_certificate() {
  local domain="$1" log ip
  say "Getting a Let's Encrypt certificate for $domain (up to 2 minutes)…"
  for _ in $(seq 1 "${XPL_CERT_TRIES:-15}"); do
    # A real, trusted certificate: fetch it locally with normal certificate checks.
    if curl -fsS -m 4 --resolve "$domain:443:127.0.0.1" "https://$domain/health" >/dev/null 2>&1; then
      ok "HTTPS is live: https://$domain"
      say "Remove the old port-8765 forward on your router: the dashboard is now only served through HTTPS."
      return 0
    fi
    sleep 3
  done
  log="$(dc logs --no-color --since 10m caddy 2>&1 || true)"
  ip="$(public_ip)"
  if printf '%s' "$log" | grep -qiE "timeout during connect|connection refused|no route to host|i/o timeout"; then
    warn "Let's Encrypt could not reach port 80 on ${ip:-your public IP}."
    warn "Forward TCP 80 and 443 on your router to this server ($(hostname -I 2>/dev/null | awk '{print $1}')),"
    warn "check that your provider doesn't block port 80, then run: xplogent-docker https $domain"
  elif printf '%s' "$log" | grep -qiE "rateLimited|too many certificates"; then
    warn "Let's Encrypt rate limit hit for $domain: wait an hour (Caddy retries by itself)."
  elif printf '%s' "$log" | grep -qiE "NXDOMAIN|DNS problem"; then
    warn "Let's Encrypt can't resolve $domain yet: check the A record, Caddy retries by itself."
  else
    warn "No certificate yet. Caddy keeps retrying; follow it with: xplogent-docker logs -f caddy"
  fi
  warn "Until then the dashboard is not reachable over HTTPS (to go back: xplogent-docker local --lan)."
  return 1
}

cmd_backup() {
  running || die "Xplogent is not running (xplogent-docker start)"
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  local ts name
  ts="$(date +%Y%m%d-%H%M%S)"; name="xplogent-$ts.tar.gz"
  say "Creating backup (database, skills, config, encrypted keys)…"
  dc exec -T xplogent xplogent backup --out "/data/backups/$name" --include-secrets >/dev/null
  # Stream it out as the container user (docker cp would keep root-only ownership issues).
  (umask 077; dc exec -T xplogent cat "/data/backups/$name" >"$BACKUP_DIR/$name")
  dc exec -T xplogent rm -f "/data/backups/$name" || true
  # Keep the newest $KEEP_BACKUPS.
  find "$BACKUP_DIR" -maxdepth 1 -name 'xplogent-*.tar.gz' -printf '%T@ %p\n' \
    | sort -rn | tail -n +$((KEEP_BACKUPS + 1)) | cut -d' ' -f2- | xargs -r rm -f
  ok "Backup: $BACKUP_DIR/$name (contains your API keys; keep it private)"
}

DEPLOY_FILES="deploy/docker/docker-compose.yml deploy/docker/compose.https.yml
deploy/docker/compose.local.yml deploy/docker/compose.sip.yml deploy/docker/.env.example deploy/caddy/Caddyfile"

rollback_files() {
  local f
  for f in $DEPLOY_FILES; do
    [ -f "$DIR/$f.prev" ] && mv "$DIR/$f.prev" "$DIR/$f"
  done
  return 0
}

cmd_update() {
  if running; then cmd_backup; else warn "not running: skipping the pre-update backup"; fi
  if [ -f "$DIR/.install-info" ] && command -v curl >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    . "$DIR/.install-info"
    say "Refreshing deploy files from $REPO@$REF"
    local f tmp
    for f in $DEPLOY_FILES; do
      [ -f "$DIR/$f" ] && cp -p "$DIR/$f" "$DIR/$f.prev"
      tmp="$DIR/$f.download"
      if curl -fsSL "https://raw.githubusercontent.com/$REPO/$REF/$f" -o "$tmp"; then
        chmod 644 "$tmp"; mv "$tmp" "$DIR/$f"
      else
        rm -f "$tmp"; warn "could not refresh $f; keeping the current copy"
      fi
    done
  fi
  say "Pulling new images…"
  if ! dc pull --quiet; then
    rollback_files
    die "could not download the new images (tag not published yet, package not public, or no network); the running version was not changed"
  fi
  for f in $DEPLOY_FILES; do rm -f "$DIR/$f.prev"; done
  apply
  docker image prune -f >/dev/null 2>&1 || true
  update_helper
  ok "Updated. Open $(url)"
}

# Replace this helper with the latest one (new commands), keeping the install dir.
# mv swaps the file atomically, so the running copy finishes undisturbed.
update_helper() {
  [ -f "$DIR/.install-info" ] && command -v curl >/dev/null 2>&1 || return 0
  # shellcheck disable=SC1091
  . "$DIR/.install-info"
  local self tmp
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  tmp="$(mktemp "$self.XXXXXX")" || return 0
  if curl -fsSL "https://raw.githubusercontent.com/$REPO/$REF/deploy/docker/xplogent-docker" -o "$tmp.src" \
      && XPL_D="$DIR" awk 'BEGIN { d = ENVIRON["XPL_D"] }
           /^DEFAULT_DIR=/ { print "DEFAULT_DIR=\"" d "\""; next } { print }' "$tmp.src" >"$tmp" \
      && bash -n "$tmp"; then
    chmod 755 "$tmp"; mv "$tmp" "$self"; cp "$tmp.src" "$COMPOSE_DIR/xplogent-docker" 2>/dev/null || true
  else
    rm -f "$tmp"; warn "could not refresh the xplogent-docker helper; keeping this one"
  fi
  rm -f "$tmp.src"
}

cmd_restore() {
  local file="${1:-}"
  [ -f "$file" ] || die "usage: xplogent-docker restore <backup.tar.gz>"
  running || die "Xplogent must be running to restore (xplogent-docker start)"
  say "Restoring $file (current data is overwritten)…"
  dc exec -T xplogent sh -c 'cat > /tmp/restore.tar.gz' <"$file"
  dc exec -T xplogent xplogent restore /tmp/restore.tar.gz
  dc exec -T xplogent rm -f /tmp/restore.tar.gz || true
  dc restart xplogent
  wait_healthy
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  status)
    dc ps
    echo
    running || die "not running (xplogent-docker start)"
    cid="$(dc ps -q xplogent)"
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$cid" 2>/dev/null || true)"
    if [ "$health" = "starting" ]; then
      # Just (re)started: give it the healthcheck's start period before judging.
      say "starting up…"
      for _ in $(seq 1 30); do
        sleep 2
        health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$cid" 2>/dev/null || true)"
        [ "$health" = "starting" ] || break
      done
    fi
    if dc exec -T xplogent python -c \
        "import urllib.request as u; u.urlopen('http://127.0.0.1:8765/health', timeout=3)" >/dev/null 2>&1; then
      ok "healthy: $(url)"
    else
      warn "not healthy (state: ${health:-unknown}); see: xplogent-docker logs"
    fi ;;
  logs)
    follow=""; svc=xplogent
    for a in "$@"; do case "$a" in -f|--follow) follow=-f ;; *) svc="$a" ;; esac; done
    dc logs --tail 200 ${follow:+"$follow"} "$svc" ;;
  update) cmd_update ;;
  backup) cmd_backup ;;
  restore) cmd_restore "$@" ;;
  token)
    if [ "${1:-}" = "--rotate" ]; then
      set_env "$ENV_FILE" XPLOGENT_AUTH_TOKEN "$(gen_token)"
      apply
      ok "New token (the old one stops working now):"
    fi
    get_env XPLOGENT_AUTH_TOKEN ;;
  config)
    "${EDITOR:-$(command -v nano || command -v vi)}" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    apply ;;
  restart) dc restart; wait_healthy ;;
  stop) dc stop ;;
  start) apply ;;
  https)
    domain="" force=0
    for a in "$@"; do case "$a" in --force) force=1 ;; *) domain="$a" ;; esac; done
    [ -n "$domain" ] || die "usage: xplogent-docker https your.domain.com [--force]"
    case "$domain" in *[!A-Za-z0-9.-]*|.*|*.) die "not a valid hostname: $domain" ;; esac
    [ "$force" = 1 ] || https_precheck "$domain"
    set_env "$ENV_FILE" DOMAIN "$domain"
    set_env "$ENV_FILE" COMPOSE_FILE "$(compose_files compose.https.yml)"
    apply
    set_public_url "$domain"
    wait_certificate "$domain" ;;
  local)
    bind=127.0.0.1; [ "${1:-}" = "--lan" ] && bind=0.0.0.0
    set_env "$ENV_FILE" XPLOGENT_BIND "$bind"
    set_env "$ENV_FILE" COMPOSE_FILE "$(compose_files compose.local.yml)"
    apply
    ok "No-domain mode: $(url)" ;;
  ollama)
    case "${1:-}" in
      on)
        if [ "${2:-}" = "--gpu" ]; then add_profile ollama-gpu; else add_profile ollama; fi
        set_env "$ENV_FILE" OLLAMA_HOST "http://ollama:11434"
        apply
        ok "Ollama is on. Download a model: xplogent-docker pull-model llama3.1" ;;
      off)
        # A container whose profile is switched off is otherwise left running.
        COMPOSE_PROFILES=ollama,ollama-gpu dc rm -sf ollama ollama-gpu >/dev/null 2>&1 || true
        add_profile -ollama
        set_env "$ENV_FILE" OLLAMA_HOST ""
        apply ;;
      *) die "usage: xplogent-docker ollama on [--gpu] | off" ;;
    esac ;;
  backup-model)
    # Local Ollama as the automatic backup when the main model/server is unavailable.
    case "${1:-}" in
      on)
        model="${2:-llama3.2:3b}"
        [ "${2:-}" = "--gpu" ] && model="llama3.2:3b"
        if [ "${2:-}" = "--gpu" ] || [ "${3:-}" = "--gpu" ]; then add_profile ollama-gpu; else add_profile ollama; fi
        apply
        say "Downloading $model on the local Ollama (first time only; ~2 GB for llama3.2:3b)…"
        dc exec -T ollama ollama pull "$model"
        dc exec -T -e XPL_FB_MODEL="$model" xplogent python -c \
          "import os; from xplogent.core.config import save_user_config; save_user_config({'fallback': {'enabled': True, 'model': os.environ['XPL_FB_MODEL']}})"
        ok "Backup model on: $model answers when the main model is unavailable." ;;
      off)
        dc exec -T xplogent python -c \
          "from xplogent.core.config import save_user_config; save_user_config({'fallback': {'enabled': False}})" || true
        COMPOSE_PROFILES=ollama,ollama-gpu dc rm -sf ollama ollama-gpu >/dev/null 2>&1 || true
        add_profile -ollama
        apply
        ok "Backup model off (downloaded models are kept in the ollama-models volume)." ;;
      *) die "usage: xplogent-docker backup-model on [model] [--gpu] | off" ;;
    esac ;;
  speech)
    case "${1:-}" in
      on)
        # speech and gpu-speech are alternatives (both provide "kokoro").
        add_profile -speech; add_profile -gpu-speech
        if [ "${2:-}" = "--gpu" ]; then add_profile gpu-speech; else add_profile speech; fi
        apply
        ok "Local speech is on. In the dashboard: Calls -> Speech -> 'Local on this server'." ;;
      off)
        COMPOSE_PROFILES=speech,gpu-speech dc rm -sf kokoro-cpu kokoro whisper >/dev/null 2>&1 || true
        add_profile -speech; add_profile -gpu-speech
        apply ;;
      *) die "usage: xplogent-docker speech on [--gpu] | off" ;;
    esac ;;
  sip)
    mode_file=compose.local.yml
    case "$(get_env COMPOSE_FILE)" in *https*) mode_file=compose.https.yml ;; esac
    case "${1:-}" in
      on)
        ip=""
        if [ "${2:-}" = "--ip" ]; then ip="${3:-}"; [ -n "$ip" ] || die "usage: xplogent-docker sip on --ip ADDRESS"; fi
        [ -n "$ip" ] || ip="$(get_env XPLOGENT_HOST_IP)"
        [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
        case "$ip" in *[!0-9.]*) die "not an IPv4 address: $ip" ;; esac
        set_env "$ENV_FILE" XPLOGENT_SIP 1
        set_env "$ENV_FILE" XPLOGENT_HOST_IP "$ip"
        set_env "$ENV_FILE" COMPOSE_FILE "$(compose_files "$mode_file")"
        apply
        sp="$(get_env XPLOGENT_SIP_PORT)"; rs="$(get_env XPLOGENT_RTP_START)"; re="$(get_env XPLOGENT_RTP_END)"
        xp="$(get_env XPLOGENT_SIP_EXT_PORT)"; xs="$(get_env XPLOGENT_RTP_EXT_START)"; xe="$(get_env XPLOGENT_RTP_EXT_END)"
        ok "SIP ports open: trunk UDP ${sp:-5060} + ${rs:-10000}-${re:-10100}, PBX extension line UDP ${xp:-5062} + ${xs:-10200}-${xe:-10300}; this server is ${ip:-unknown}."
        say "Firewall: sudo ufw allow ${sp:-5060}/udp && sudo ufw allow ${rs:-10000}:${re:-10100}/udp"
        say "  (extension line: sudo ufw allow ${xp:-5062}/udp && sudo ufw allow ${xs:-10200}:${xe:-10300}/udp)"
        say "Behind a router with a SIP provider on the internet: forward those UDP ports here and"
        say "use 'xplogent-docker sip on --ip <public IP>'. Then: dashboard -> Calls -> Phone line -> SIP trunk." ;;
      off)
        set_env "$ENV_FILE" XPLOGENT_SIP 0
        set_env "$ENV_FILE" COMPOSE_FILE "$(compose_files "$mode_file")"
        apply
        ok "SIP ports closed." ;;
      *) die "usage: xplogent-docker sip on [--ip ADDRESS] | off" ;;
    esac ;;
  cli)
    running || die "Xplogent is not running (xplogent-docker start)"
    dc exec xplogent xplogent "$@" ;;
  pull-model)
    [ -n "${1:-}" ] || die "usage: xplogent-docker pull-model <name>"
    dc exec ollama ollama pull "$1" ;;
  uninstall)
    # Address every service, whatever mode/profiles are currently enabled.
    export COMPOSE_FILE="docker-compose.yml:compose.https.yml:compose.local.yml"
    export COMPOSE_PROFILES="ollama,ollama-gpu,speech,gpu-speech"
    if [ "${1:-}" = "--purge" ]; then
      printf 'This deletes ALL Xplogent data (memory, chats, keys) and backups in %s. Type "delete" to confirm: ' "$DIR"
      read -r confirm
      [ "$confirm" = "delete" ] || die "cancelled"
      dc down -v --remove-orphans
      rm -rf "$DIR"
    else
      dc down --remove-orphans
      say "Containers removed; data volumes and $DIR kept (use --purge to delete everything)."
    fi
    rm -f /usr/local/bin/xplogent-docker 2>/dev/null || true ;;
  url) url ;;
  help|-h|--help) sed -n '2,24p' "$0" ;;
  *) die "unknown command: $cmd (xplogent-docker help)" ;;
esac
