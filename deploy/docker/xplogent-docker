#!/usr/bin/env bash
# xplogent-docker: manage an Xplogent Docker install (made by get.sh).
#
#   xplogent-docker status              containers, health, URL
#   xplogent-docker logs [-f] [service] logs (default: xplogent)
#   xplogent-docker update              backup, refresh deploy files, pull new image, restart
#   xplogent-docker backup              consistent backup (incl. keys) into <dir>/backups
#   xplogent-docker restore FILE        restore a backup (overwrites current data)
#   xplogent-docker token [--rotate]    show (or replace) the dashboard access token
#   xplogent-docker config              edit settings (.env), then apply them
#   xplogent-docker restart | stop | start
#   xplogent-docker https DOMAIN        switch to HTTPS with your domain
#   xplogent-docker local [--lan]       switch to no-domain mode (port 8765)
#   xplogent-docker ollama on [--gpu] | off
#   xplogent-docker pull-model NAME     download an Ollama model (e.g. llama3.1)
#   xplogent-docker uninstall [--purge] remove containers (--purge: also all data!)
#
# Install directory: $XPLOGENT_DOCKER_DIR, else the directory below (set by get.sh),
# else the checkout this script lives in.

set -euo pipefail

DEFAULT_DIR="/opt/xplogent-docker"
KEEP_BACKUPS=10

say()  { printf '\033[1;36m•\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -n "${XPLOGENT_DOCKER_DIR:-}" ]; then
  DIR="$XPLOGENT_DOCKER_DIR"; COMPOSE_DIR="$DIR/deploy/docker"
elif [ -f "$DEFAULT_DIR/deploy/docker/docker-compose.yml" ]; then
  DIR="$DEFAULT_DIR"; COMPOSE_DIR="$DIR/deploy/docker"
elif [ -f "$here/docker-compose.yml" ]; then
  COMPOSE_DIR="$here"; DIR="$(cd "$here/../.." && pwd)"
else
  die "no Xplogent Docker install found (looked in $DEFAULT_DIR); run get.sh first"
fi
ENV_FILE="$COMPOSE_DIR/.env"
BACKUP_DIR="$DIR/backups"
[ -f "$ENV_FILE" ] || die "$ENV_FILE is missing; run get.sh (or copy .env.example)"
cd "$COMPOSE_DIR"

set_env() {
  local file="$1" key="$2" tmp
  case "$3" in *$'\n'*) die "value for $key must be a single line" ;; esac
  tmp="$(mktemp "$file.XXXXXX")"
  XPL_V="$3" awk -v k="$key" '
    BEGIN { v = ENVIRON["XPL_V"]; done = 0 }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }' "$file" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}
get_env() { awk -v k="$1" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$ENV_FILE"; }
gen_token() {
  if command -v openssl >/dev/null 2>&1; then openssl rand -hex 32
  else head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; fi
}
dc() { docker compose "$@"; }

running() { [ -n "$(dc ps -q xplogent 2>/dev/null)" ]; }

wait_healthy() {
  for _ in $(seq 1 60); do
    if dc exec -T xplogent python -c \
        "import urllib.request as u; u.urlopen('http://127.0.0.1:8765/health', timeout=3)" >/dev/null 2>&1; then
      ok "Xplogent is healthy"; return 0
    fi
    sleep 2
  done
  die "Xplogent did not become healthy; check: xplogent-docker logs"
}

url() {
  case "$(get_env COMPOSE_FILE)" in
    *https*) echo "https://$(get_env DOMAIN)" ;;
    *)
      local host=127.0.0.1
      if [ "$(get_env XPLOGENT_BIND)" = "0.0.0.0" ]; then
        host="$(hostname -I 2>/dev/null | awk '{print $1}')"; host="${host:-<server-ip>}"
      fi
      echo "http://$host:$(get_env XPLOGENT_PORT | sed 's/^$/8765/')" ;;
  esac
}

apply() { dc up -d --remove-orphans; wait_healthy; }

add_profile() {  # add_profile NAME / remove with "-NAME"
  local cur new="" p want="$1"
  cur="$(get_env COMPOSE_PROFILES)"
  for p in ${cur//,/ }; do
    # ollama and ollama-gpu are alternatives: setting or removing one drops both.
    case "$p:${want#-}" in ollama*:ollama*) continue ;; esac
    [ "$p" = "${want#-}" ] && continue
    new="${new:+$new,}$p"
  done
  case "$want" in -*) ;; *) new="${new:+$new,}$want" ;; esac
  set_env "$ENV_FILE" COMPOSE_PROFILES "$new"
}

cmd_backup() {
  running || die "Xplogent is not running (xplogent-docker start)"
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  local ts name
  ts="$(date +%Y%m%d-%H%M%S)"; name="xplogent-$ts.tar.gz"
  say "Creating backup (database, skills, config, encrypted keys)…"
  dc exec -T xplogent xplogent backup --out "/data/backups/$name" --include-secrets >/dev/null
  # Stream it out as the container user (docker cp would keep root-only ownership issues).
  (umask 077; dc exec -T xplogent cat "/data/backups/$name" >"$BACKUP_DIR/$name")
  dc exec -T xplogent rm -f "/data/backups/$name" || true
  # Keep the newest $KEEP_BACKUPS.
  find "$BACKUP_DIR" -maxdepth 1 -name 'xplogent-*.tar.gz' -printf '%T@ %p\n' \
    | sort -rn | tail -n +$((KEEP_BACKUPS + 1)) | cut -d' ' -f2- | xargs -r rm -f
  ok "Backup: $BACKUP_DIR/$name (contains your API keys; keep it private)"
}

DEPLOY_FILES="deploy/docker/docker-compose.yml deploy/docker/compose.https.yml
deploy/docker/compose.local.yml deploy/docker/.env.example deploy/caddy/Caddyfile"

rollback_files() {
  local f
  for f in $DEPLOY_FILES; do
    [ -f "$DIR/$f.prev" ] && mv "$DIR/$f.prev" "$DIR/$f"
  done
  return 0
}

cmd_update() {
  if running; then cmd_backup; else warn "not running: skipping the pre-update backup"; fi
  if [ -f "$DIR/.install-info" ] && command -v curl >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    . "$DIR/.install-info"
    say "Refreshing deploy files from $REPO@$REF"
    local f tmp
    for f in $DEPLOY_FILES; do
      [ -f "$DIR/$f" ] && cp -p "$DIR/$f" "$DIR/$f.prev"
      tmp="$DIR/$f.download"
      if curl -fsSL "https://raw.githubusercontent.com/$REPO/$REF/$f" -o "$tmp"; then
        chmod 644 "$tmp"; mv "$tmp" "$DIR/$f"
      else
        rm -f "$tmp"; warn "could not refresh $f; keeping the current copy"
      fi
    done
  fi
  say "Pulling new images…"
  if ! dc pull --quiet; then
    rollback_files
    die "could not download the new images (network, or GHCR package not public?); nothing was changed"
  fi
  for f in $DEPLOY_FILES; do rm -f "$DIR/$f.prev"; done
  apply
  docker image prune -f >/dev/null 2>&1 || true
  ok "Updated. Open $(url)"
}

cmd_restore() {
  local file="${1:-}"
  [ -f "$file" ] || die "usage: xplogent-docker restore <backup.tar.gz>"
  running || die "Xplogent must be running to restore (xplogent-docker start)"
  say "Restoring $file (current data is overwritten)…"
  dc exec -T xplogent sh -c 'cat > /tmp/restore.tar.gz' <"$file"
  dc exec -T xplogent xplogent restore /tmp/restore.tar.gz
  dc exec -T xplogent rm -f /tmp/restore.tar.gz || true
  dc restart xplogent
  wait_healthy
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  status)
    dc ps
    echo
    if running && dc exec -T xplogent python -c \
        "import urllib.request as u; u.urlopen('http://127.0.0.1:8765/health', timeout=3)" >/dev/null 2>&1; then
      ok "healthy: $(url)"
    else
      warn "not healthy (xplogent-docker logs)"
    fi ;;
  logs)
    follow=""; svc=xplogent
    for a in "$@"; do case "$a" in -f|--follow) follow=-f ;; *) svc="$a" ;; esac; done
    dc logs --tail 200 ${follow:+"$follow"} "$svc" ;;
  update) cmd_update ;;
  backup) cmd_backup ;;
  restore) cmd_restore "$@" ;;
  token)
    if [ "${1:-}" = "--rotate" ]; then
      set_env "$ENV_FILE" XPLOGENT_AUTH_TOKEN "$(gen_token)"
      apply
      ok "New token (the old one stops working now):"
    fi
    get_env XPLOGENT_AUTH_TOKEN ;;
  config)
    "${EDITOR:-$(command -v nano || command -v vi)}" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    apply ;;
  restart) dc restart; wait_healthy ;;
  stop) dc stop ;;
  start) apply ;;
  https)
    domain="${1:-}"
    [ -n "$domain" ] || die "usage: xplogent-docker https your.domain.com"
    case "$domain" in *[!A-Za-z0-9.-]*|.*|*.) die "not a valid hostname: $domain" ;; esac
    set_env "$ENV_FILE" DOMAIN "$domain"
    set_env "$ENV_FILE" COMPOSE_FILE "docker-compose.yml:compose.https.yml"
    apply
    ok "HTTPS mode: https://$domain (the certificate is issued once DNS points here and ports 80/443 are open)" ;;
  local)
    bind=127.0.0.1; [ "${1:-}" = "--lan" ] && bind=0.0.0.0
    set_env "$ENV_FILE" XPLOGENT_BIND "$bind"
    set_env "$ENV_FILE" COMPOSE_FILE "docker-compose.yml:compose.local.yml"
    apply
    ok "No-domain mode: $(url)" ;;
  ollama)
    case "${1:-}" in
      on)
        if [ "${2:-}" = "--gpu" ]; then add_profile ollama-gpu; else add_profile ollama; fi
        set_env "$ENV_FILE" OLLAMA_HOST "http://ollama:11434"
        apply
        ok "Ollama is on. Download a model: xplogent-docker pull-model llama3.1" ;;
      off)
        # A container whose profile is switched off is otherwise left running.
        COMPOSE_PROFILES=ollama,ollama-gpu dc rm -sf ollama ollama-gpu >/dev/null 2>&1 || true
        add_profile -ollama
        set_env "$ENV_FILE" OLLAMA_HOST ""
        apply ;;
      *) die "usage: xplogent-docker ollama on [--gpu] | off" ;;
    esac ;;
  pull-model)
    [ -n "${1:-}" ] || die "usage: xplogent-docker pull-model <name>"
    dc exec ollama ollama pull "$1" ;;
  uninstall)
    # Address every service, whatever mode/profiles are currently enabled.
    export COMPOSE_FILE="docker-compose.yml:compose.https.yml:compose.local.yml"
    export COMPOSE_PROFILES="ollama,ollama-gpu,gpu-speech"
    if [ "${1:-}" = "--purge" ]; then
      printf 'This deletes ALL Xplogent data (memory, chats, keys) and backups in %s. Type "delete" to confirm: ' "$DIR"
      read -r confirm
      [ "$confirm" = "delete" ] || die "cancelled"
      dc down -v --remove-orphans
      rm -rf "$DIR"
    else
      dc down --remove-orphans
      say "Containers removed; data volumes and $DIR kept (use --purge to delete everything)."
    fi
    rm -f /usr/local/bin/xplogent-docker 2>/dev/null || true ;;
  url) url ;;
  help|-h|--help) sed -n '2,19p' "$0" ;;
  *) die "unknown command: $cmd (xplogent-docker help)" ;;
esac
